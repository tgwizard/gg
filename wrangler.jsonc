{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gg",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Per-IP limits, enforced in the worker. Generous on purpose: they stop scripts,
  // not people (see "Limits" in docs/ARCHITECTURE.md).
  "ratelimits": [
    { "name": "CREATE_ROOM_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONNECT_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
